# GO 指向要使用的 Go 工具链。默认取 PATH 上的 go；
# 若本机的 Go 不在 PATH 上，可以覆盖，例如：
#   make GO=$HOME/sdk/go/bin/go test
GO ?= go

.PHONY: build run test wire{{if .WithGRPC}} proto{{end}}

build:
	$(GO) build ./...

run:
	$(GO) run ./cmd/server

test:
	$(GO) test -race ./...

# wire 重新生成装配代码。改了 internal/*/module.go 或 cmd/server/wire.go
# 之后要跑一遍，把结果提交进版本库——wire_gen.go 是生成好的文件，
# 项目构建不依赖 wire 工具本身。
wire:
	$(GO) run github.com/google/wire/cmd/wire ./...
{{if .WithGRPC}}
# PROTOC 与插件的位置。默认取 PATH 上的，可覆盖。
PROTOC ?= protoc
PROTO_DIR ?= api

# proto 根据 idl 生成 Go 代码。生成物与 .proto 同目录。改了 api/*/v1/*.proto
# 之后要跑一遍，把结果提交进版本库——.pb.go 是生成好的文件，项目构建不依赖
# protoc 本身。
proto:
	$(PROTOC) --proto_path=$(PROTO_DIR) \
		--go_out=$(PROTO_DIR) --go_opt=paths=source_relative \
		--go-grpc_out=$(PROTO_DIR) --go-grpc_opt=paths=source_relative \
		$(shell find $(PROTO_DIR) -name '*.proto')
{{end}}
