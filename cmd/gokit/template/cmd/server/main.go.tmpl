// Command server 是 {{.Name}} 的启动入口。
package main

import (
	"context"
	"flag"
	"fmt"
	"net/http"
	"os"
{{if .WithSQL}}
	_ "modernc.org/sqlite" // 注册 sqlite 驱动，框架本身不绑定任何驱动
{{end}}
	"github.com/Kline-x/gokit/app"
{{if .WithGRPC}}	"github.com/Kline-x/gokit/component/grpcserver"
{{end}}	"github.com/Kline-x/gokit/component/httpserver"
	"github.com/Kline-x/gokit/component/log"
{{if .WithSQL}}	"github.com/Kline-x/gokit/component/sqldb"
{{end}}	"github.com/Kline-x/gokit/config"

{{if .WithSQL}}	"{{.ModPath}}/internal/{{.Module}}/infrastructure"
{{end}}	"{{.ModPath}}/internal/{{.Module}}/interfaces"
)

// Config 是本应用的聚合配置，按组件名挂子节点。
type Config struct {
	Log  log.Config        `yaml:"log"`
	HTTP httpserver.Config `yaml:"http"`
{{if .WithGRPC}}	GRPC grpcserver.Config `yaml:"grpc"`
{{end}}{{if .WithSQL}}	DB   sqldb.Config      `yaml:"db"`
{{end}}}

func defaultConfig() Config {
{{if .WithSQL}}	dbCfg := sqldb.DefaultConfig()
	dbCfg.Driver = "sqlite"
	dbCfg.DSN = "file:{{.Name}}.db"

{{end}}	return Config{
		Log:  log.DefaultConfig(),
		HTTP: httpserver.DefaultConfig(),
{{if .WithGRPC}}		GRPC: grpcserver.DefaultConfig(),
{{end}}{{if .WithSQL}}		DB:   dbCfg,
{{end}}	}
}

// Bundle 汇总一次装配产出的对象。
//
// 这里刻意不逐个列出基础设施组件：要托管哪些组件由 provideComponents 决定，
// 而 provideComponents 的入参又由 wire 按当前引入的装配集合推导。
type Bundle struct {
	App        *app.App
	HTTP       *httpserver.Server
{{if .WithGRPC}}	GRPC       *grpcserver.Server
{{end}}	Components []app.Component
}

// Register 把组件按启动顺序交给 App。真正的先后由各组件的 DependsOn 决定。
func (b *Bundle) Register() *app.App {
	b.App.Register(b.Components...)
	return b.App
}

func provideLogConfig(cfg Config) log.Config         { return cfg.Log }
func provideHTTPConfig(cfg Config) httpserver.Config { return cfg.HTTP }
{{if .WithGRPC}}func provideGRPCConfig(cfg Config) grpcserver.Config { return cfg.GRPC }
{{end}}{{if .WithSQL}}func provideDBConfig(cfg Config) sqldb.Config        { return cfg.DB }
{{end}}
func provideApp(logger *log.Logger) *app.App {
	return app.New(app.WithName("{{.Name}}"), app.WithLogger(logger.Logger))
}

// provideHandler 组装路由与中间件。各业务模块在这里挂自己的路由。
func provideHandler(logger *log.Logger, {{.Module}} *interfaces.HTTPHandler) http.Handler {
	mux := http.NewServeMux()
	{{.Module}}.Register(mux)
	return httpserver.Chain(mux,
		httpserver.RequestLog(logger.Logger),
		httpserver.Recover(logger.Logger),
	)
}

// provideHTTPServer 把 App.Fatal 接给服务，让运行期异常触发整体优雅退出。
func provideHTTPServer(cfg httpserver.Config, h http.Handler, a *app.App) *httpserver.Server {
	return httpserver.New(cfg, h, httpserver.WithFatal(a.Fatal))
}
{{if .WithGRPC}}
// provideServiceRegistrars 列出要挂到 gRPC 服务器上的服务。
// 各业务模块的 gRPC 接口层在这里汇总。
func provideServiceRegistrars({{.Module}} *interfaces.GRPCHandler) []grpcserver.ServiceRegistrar {
	return []grpcserver.ServiceRegistrar{
		{{.Module}},
	}
}

// provideGRPCServer 把 App.Fatal 接给服务。
// 只需要传 RequestLog：Recover 与 ErrorMapper 由 grpcserver 默认装在最内层，
// 因此这里传进去的天然包在它们外面，RequestLog 看到的正是已经翻译过的状态码。
func provideGRPCServer(
	cfg grpcserver.Config,
	services []grpcserver.ServiceRegistrar,
	logger *log.Logger,
	a *app.App,
) *grpcserver.Server {
	return grpcserver.New(cfg, services,
		grpcserver.WithFatal(a.Fatal),
		grpcserver.WithLogger(logger.Logger),
		grpcserver.WithUnaryInterceptor(
			grpcserver.RequestLog(logger.Logger),
		),
	)
}
{{end}}
// provideComponents 列出本次装配要交给 App 托管的组件。
//
// 换用远程实现时，这个函数的入参要跟着装配集合一起改——不再需要的共享基础
// 设施（例如数据库）必须同时从这里和 wire.Build 里去掉，否则进程仍会去连一个
// 它根本不用的库。
func provideComponents(
	logger *log.Logger,
{{if .WithSQL}}	db *sqldb.DB,
	migrator *infrastructure.Migrator,
{{end}}	httpSrv *httpserver.Server,
{{if .WithGRPC}}	grpcSrv *grpcserver.Server,
{{end}}) []app.Component {
	return []app.Component{logger, {{if .WithSQL}}db, migrator, {{end}}httpSrv{{if .WithGRPC}}, grpcSrv{{end}}}
}

func main() {
	var configPath string
	flag.StringVar(&configPath, "config", "configs/config.yaml", "配置文件路径")
	flag.Parse()

	cfg := defaultConfig()
	loader := config.New(
		config.WithOptionalFile(configPath),
		config.WithEnvPrefix("{{.EnvPrefix}}"),
	)
	if err := loader.Load(&cfg); err != nil {
		fmt.Fprintln(os.Stderr, "加载配置失败:", err)
		os.Exit(1)
	}

	b, err := initApp(cfg)
	if err != nil {
		fmt.Fprintln(os.Stderr, "装配失败:", err)
		os.Exit(1)
	}

	ctx := context.Background()
	if err := b.Register().Run(ctx); err != nil {
		fmt.Fprintln(os.Stderr, "运行失败:", err)
		os.Exit(1)
	}
}
