//go:build wireinject

package main

import (
	"github.com/google/wire"

	"github.com/Kline-x/gokit/component/log"
{{if .WithSQL}}	"github.com/Kline-x/gokit/component/sqldb"
{{end}}
	"{{.ModPath}}/internal/{{.Module}}"
{{if .WithSQL}}	"{{.ModPath}}/internal/{{.Module}}/application"
{{end}})

// initApp 由 wire 在编译期生成实现：按依赖关系把各组件与业务模块装配起来。
//
// 本文件与 provideComponents 一起构成组合根。业务代码——domain、application、
// interfaces 三层——一行都不用动，这才是这套分层想换来的东西。
func initApp(cfg Config) (*Bundle, error) {
	panic(wire.Build(
		provideLogConfig,
		provideHTTPConfig,
{{if .WithSQL}}		provideDBConfig,
{{end}}		log.New,
		provideApp,
		provideHandler,
		provideHTTPServer,
		provideComponents,
{{if .WithSQL}}		sqldb.New,
		// 事务能力由共享的数据库组件提供。这个绑定放在组合根而不是业务模块里，
		// 因为它把应用层的接口接到了全应用共享的基础设施上。
		wire.Bind(new(application.Transactor), new(*sqldb.DB)),
{{end}}		{{.Module}}.LocalSet,
		wire.Struct(new(Bundle), "*"),
	))
}
